# Environment Configuration for Masal AI Lead Assistant
# Copy this file to .env and fill in your actual credentials.
# Never commit .env to version control.

# Google Gemini API Key (keep server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database URL (Phase 4+)
DATABASE_URL=sqlite:///./leads.db

# CORS Allowed Origins (comma-separated list for local frontend dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
